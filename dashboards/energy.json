{
  "title": "Electricity",
  "uid": "shelly-energy",
  "tags": ["energy", "shelly"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "description": "The energy Prometheus. Add it once as a Grafana datasource with uid energy-prometheus -- see `make datasource`.",
        "current": { "text": "Energy", "value": "energy-prometheus" },
        "hide": 0
      },
      {
        "name": "channel",
        "label": "Channel",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${ds}" },
        "query": { "query": "label_values(shelly_power_watts, name)", "refId": "channels" },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": ["All"], "value": ["$__all"] },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Drawing now",
      "description": "Sum of instantaneous active power across every metered channel.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "shelly:power_watts:sum", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Price now (EUR/kWh)",
      "description": "Day-ahead spot price for the configured zone plus fixed charges, with VAT applied. This is the figure the cost rules multiply by.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "shelly_price_eur_per_kwh{component=\"total\"}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Energy over range",
      "description": "Summed from the recorded 5-minute deltas, so it is the real metered figure for the selected window rather than an average of power readings.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time(shelly:energy_kwh:increase5m{name=~\"$channel\"}[$__range]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 2,
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cost over range",
      "description": "Each 5-minute slice priced at the tariff in force at the time, then summed. Changing today's price does not rewrite last month's cost.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time(shelly:cost_eur:increase5m{name=~\"$channel\"}[$__range]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 2,
          "color": { "mode": "fixed", "fixedColor": "text" }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Power by channel",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "shelly_power_watts{name=~\"$channel\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": ["lastNotNull", "max", "mean"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "decimals": 1,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMax": 100
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "plug-a" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "plug-b" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }] },
          { "matcher": { "id": "byName", "options": "mini-1pm" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] },
          { "matcher": { "id": "byName", "options": "strip-socket-1" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } }] },
          { "matcher": { "id": "byName", "options": "strip-socket-2" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d55181" } }] },
          { "matcher": { "id": "byName", "options": "strip-socket-3" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#0ca30c" } }] },
          { "matcher": { "id": "byName", "options": "strip-socket-4" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#9085e9" } }] }
        ]
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Electricity price (EUR/kWh)",
      "description": "Spot is the raw day-ahead market price; total adds distribution, margin and VAT. Steps are 15 minutes because that is the market interval.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "shelly_price_eur_per_kwh{component=\"total\"}",
          "legendFormat": "total"
        },
        {
          "refId": "B",
          "expr": "shelly_price_eur_per_kwh{component=\"spot\"}",
          "legendFormat": "spot"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "total" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "spot" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } }] }
        ]
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Energy over range, by channel",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum_over_time(shelly:energy_kwh:increase5m{name=~\"$channel\"}[$__range])",
          "legendFormat": "{{name}}",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "text",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 2,
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "#3987e5" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "plug-a" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }] },
          { "matcher": { "id": "byName", "options": "plug-b" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }] },
          { "matcher": { "id": "byName", "options": "mini-1pm" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } }] },
          { "matcher": { "id": "byName", "options": "strip-socket-1" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } }] },
          { "matcher": { "id": "byName", "options": "strip-socket-2" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d55181" } }] },
          { "matcher": { "id": "byName", "options": "strip-socket-3" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#0ca30c" } }] },
          { "matcher": { "id": "byName", "options": "strip-socket-4" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#9085e9" } }] }
        ]
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Energy and cost over range",
      "description": "The same numbers as the panels above, as text: sortable, and readable without relying on colour.",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 21 },
      "targets": [
        {
          "refId": "kwh",
          "expr": "sum_over_time(shelly:energy_kwh:increase5m{name=~\"$channel\"}[$__range])",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "cost",
          "expr": "sum_over_time(shelly:cost_eur:increase5m{name=~\"$channel\"}[$__range])",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "watts",
          "expr": "shelly_power_watts{name=~\"$channel\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "name", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "instance 3": true,
              "channel 1": true,
              "channel 2": true,
              "channel 3": true,
              "device 1": true,
              "device 2": true,
              "device 3": true
            },
            "renameByName": {
              "name": "Channel",
              "device": "Device",
              "channel": "Switch",
              "Value #kwh": "Energy (kWh)",
              "Value #cost": "Cost (EUR)",
              "Value #watts": "Now (W)"
            }
          }
        },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Cost (EUR)", "desc": true }] } }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Energy (kWh)" },
            "properties": [{ "id": "unit", "value": "kwatth" }, { "id": "decimals", "value": 3 }]
          },
          {
            "matcher": { "id": "byName", "options": "Cost (EUR)" },
            "properties": [{ "id": "unit", "value": "currencyEUR" }, { "id": "decimals", "value": 2 }]
          },
          {
            "matcher": { "id": "byName", "options": "Now (W)" },
            "properties": [{ "id": "unit", "value": "watt" }, { "id": "decimals", "value": 1 }]
          }
        ]
      }
    }
  ]
}
