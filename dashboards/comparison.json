                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Spare socket"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#9085e9"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "What never switching off costs, per year",
      "description": "The lowest each channel dropped to during the range, held for a year at the current tariff: standby, idle power supplies, anything you thought was off.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "legendFormat": "{{name}}",
          "expr": "min_over_time(shelly_power_watts{name=~\"$channel\"}[$__range]) * 8.76 * scalar(shelly_price_eur_per_kwh{component=\"total\"})"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "text",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 2,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "PC"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Acer monitor"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Dell monitor"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
