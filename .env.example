# Copy to .env on the cluster host and fill in. .env is gitignored: the price
# you pay is yours, not the repo's. `make deploy` turns it into the
# shelly-tariff Secret.

# "flat" -- a contracted fixed price per kWh. This is the usual case.
# "spot"  -- day-ahead market pricing; see the spot-mode block below.
PRICE_MODE=flat

# Your price per kWh, exactly as the bill states it, VAT included. Used as-is:
# nothing is added to it in flat mode.
PRICE_FLAT_EUR_PER_KWH=

# Fetch the Nord Pool day-ahead price as well, so a flat tariff can be
# compared against what the market was doing. Set to 0 to skip the call.
PRICE_ENABLED=1
PRICE_ZONE=lt

# Spot mode only, both excluding VAT.
# PRICE_FIXED_EUR_PER_KWH -- distribution + supplier margin + excise.
PRICE_FIXED_EUR_PER_KWH=0
PRICE_VAT_RATE=0
